# Copy this file to .env and set your real Gemini key before deploying.
# Get your Gemini key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_API_BASE=https://generativelanguage.googleapis.com
# Optional, comma-separated. Leave empty for same-origin Docker usage through the web container.
ALLOWED_ORIGINS=
# One concise docker log line per /api/gemini request. Does not log keys or request bodies.
PROXY_ACCESS_LOG=true

# Frontend runtime-config.js values injected at container startup.
# With these defaults, normal Gemini HTTP and Files API requests go to /api/gemini first.
RUNTIME_SERVER_MANAGED_API=true
RUNTIME_USE_CUSTOM_API_CONFIG=true
RUNTIME_USE_API_PROXY=true
RUNTIME_API_PROXY_URL=/api/gemini
